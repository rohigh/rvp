{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [{"source":"/studio/:path*","destination":"/studio/index.html"}],
  "headers": [{"source":"/studio/:path*","headers":[{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}]
}
